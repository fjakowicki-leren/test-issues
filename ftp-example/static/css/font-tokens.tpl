{# /* Local font faces — Archivo Expanded */ #}

@font-face {
  font-family: 'Archivo Expanded';
  src: url('{{ "fonts/ArchivoExpanded/ArchivoExpanded-Thin.woff2" | static_url }}') format('woff2'),
       url('{{ "fonts/ArchivoExpanded/ArchivoExpanded-Thin.woff" | static_url }}') format('woff'),
       url('{{ "fonts/ArchivoExpanded/Archivo_Expanded-Thin.ttf" | static_url }}') format('truetype');
  font-weight: 100;
  font-style: normal;
  font-display: swap;
}

